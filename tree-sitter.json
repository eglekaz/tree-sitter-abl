{
  "grammars": [
    {
      "name": "abl",
      "camelcase": "Abl",
      "scope": "source.abl",
      "file-types": [
        ".cls",
        ".i",
        ".p",
        ".w"
      ],
      "injection-regex": "^abl$"
    }
  ],
  "metadata": {
    "version": "0.0.47",
    "license": "MIT",
    "description": "Abl grammar for tree-sitter",
    "authors": [
      {
        "name": "Egle Kazbaraite"
      }
    ],
    "links": {
      "repository": "https://github.com/eglekaz/tree-sitter-abl"
    }
  },
  "bindings": {
    "c": false,
    "go": false,
    "node": true,
    "python": false,
    "rust": false,
    "swift": false
  }
}